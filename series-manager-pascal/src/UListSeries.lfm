    TabOrder = 4
  end
  object btnPrevious: TButton
    Left = 30
    Height = 35
    Top = 380
    Width = 75
    Caption = 'Previous'
    OnClick = btnPreviousClick
  end
  object btnNext: TButton
    Left = 115
    Height = 35
    Top = 380
