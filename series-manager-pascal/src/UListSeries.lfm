  end
  object edtViews: TEdit
    Left = 140
    Height = 23
    Top = 187
    Width = 200
    TabOrder = 3
  end
  object btnChangeCover: TButton
    Left = 30
    Height = 30
    Top = 230
    Width = 120
    Caption = 'Change Cover'
    OnClick = btnChangeCoverClick
  end
  object imgCover: TImage
    Left = 160
    Height = 120
    Top = 230
    Width = 180
    Stretch = True
  end
  object lstSeries: TListBox
    Left = 370
    Height = 280
    Top = 67
    Width = 200
    ItemHeight = 0
