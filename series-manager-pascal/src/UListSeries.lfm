object FListSeries: TFListSeries
  Left = 350
  Height = 450
  Top = 200
  Width = 600
  Caption = 'Series Management'
  ClientHeight = 450
  ClientWidth = 600
  OnActivate = FormActivate
  OnClose = FormClose
  LCLVersion = '2.2.0.4'
  object lblTitle: TLabel
    Left = 30
    Height = 25
    Top = 20
    Width = 250
    Caption = 'Series Administration'
    Font.Height = -18
    Font.Style = [fsBold]
    ParentColor = False
  end
  object lblName: TLabel
    Left = 30
    Height = 15
    Top = 70
    Width = 100
    Caption = 'Name:'
    ParentColor = False
  end
  object edtName: TEdit
    Left = 140
    Height = 23
    Top = 67
    Width = 200
    TabOrder = 0
  end
  object lblYear: TLabel
    Left = 30
    Height = 15
    Top = 110
    Width = 100
    Caption = 'Year:'
    ParentColor = False
  end
  object edtYear: TEdit
    Left = 140
    Height = 23
    Top = 107
    Width = 200
    TabOrder = 1
  end
  object lblReviews: TLabel
    Left = 30
    Height = 15
    Top = 150
    Width = 100
    Caption = 'Reviews:'
    ParentColor = False
  end
