  end
  object dlgOpenPicture: TOpenPictureDialog
    Filter = 'Graphics (*.png;*.jpg;*.jpeg;*.bmp)|*.png;*.jpg;*.jpeg;*.bmp'
    Left = 400
    Top = 380
  end
